# scripts/db.sh start creates an ignored .env with a random local password.
DATABASE_URL="postgresql://ftc_local:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/ftc_connect?schema=public"
PORT=3000
# These APIs are for local development until member authentication exists.
# Generate a random 32-byte hex value; do not use it in the Flutter app.
NODE_ENV=development
LOCAL_API_TOKEN=
# auth:setup generates the secret in .env. Local codes are written to ignored
# .local/otp files and are disabled in production.
OTP_MODE=local
AUTH_OTP_SECRET=
# After setting up an sms.bd account, set OTP_MODE=sms and put its API key here.
# Keep this ignored .env private; do not put the key in Flutter or Git.
# SMS_BD_API_KEY=

# Only these existing FTC IDs may review membership requests after signing in.
# Empty disables administrator access; never configure this in Flutter.
ADMIN_FTC_IDS=

# Separate administrator/test login; never adds a participant. Disabled by default.
TEST_ADMIN_ENABLED=false
TEST_ADMIN_ID=1000
TEST_ADMIN_PHONE=

# Private Cloudflare R2 Standard bucket for member photos. Keep keys in the
# backend environment only; never expose them in Flutter or Git.
R2_ACCOUNT_ID=
R2_BUCKET=ftc-connect-profile-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
