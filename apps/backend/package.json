{
  "name": "@ftc-connect/backend",
  "version": "0.0.1",
  "description": "81st FTC Connect backend skeleton",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "prisma db execute --file prisma/check.sql",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:verify": "node scripts/verify-schema.mjs",
    "roster:preview": "node scripts/preview-roster.mjs",
    "roster:import": "node scripts/import-roster.mjs",
    "test:roster": "node --test scripts/lib/roster.test.mjs",
    "test:import": "node --test scripts/lib/import-roster.test.mjs",
    "api:check": "node scripts/check-members-api.mjs",
    "auth:setup": "node scripts/auth-local.mjs setup",
    "auth:invite": "node scripts/auth-local.mjs invite",
    "auth:code": "node scripts/auth-local.mjs code",
    "auth:check": "node scripts/check-auth.mjs",
    "retention:check": "node scripts/check-retention.mjs",
    "registration:review": "node scripts/review-registration.mjs",
    "test-account:setup": "node scripts/setup-test-account.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "read-excel-file": "^9.3.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
