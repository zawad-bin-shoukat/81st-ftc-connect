generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Cadre {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String   @unique @db.VarChar(100)
  members Member[]

  @@map("cadres")
}

model Member {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ftcId              Int       @unique @map("ftc_id")
  section            String    @db.VarChar(2)
  name               String    @db.VarChar(150)
  cadreId            String    @map("cadre_id") @db.Uuid
  cadre              Cadre     @relation(fields: [cadreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bcsBatch           Int?       @map("bcs_batch") @db.SmallInt
  education          String   @db.Text
  university         String   @db.VarChar(255)
  phone              String    @unique @db.Text
  email              String   @db.VarChar(255)
  bloodGroup         String   @map("blood_group") @db.Text
  homeDistrict       String   @map("home_district") @db.VarChar(100)
  aboutMe            String?   @map("about_me") @db.Text
  favouriteQuotation String?   @map("favourite_quotation") @db.Text
  profilePhotoKey    String?   @map("profile_photo_key") @db.VarChar(500)
  isActive           Boolean   @default(true) @map("is_active")
  phoneVerifiedAt    DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  account            Account?
  claimInvites       ClaimInvite[]
  otpChallenges      OtpChallenge[]

  @@index([cadreId])
  @@map("members")
}

model Account {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId           String   @unique @map("member_id") @db.Uuid
  member             Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  loginPhone         String   @unique @map("login_phone") @db.VarChar(16)
  verificationMethod String   @map("verification_method") @db.VarChar(10)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions           AuthSession[]
  @@map("accounts")
}

model ClaimInvite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  challenges OtpChallenge[]
  @@index([memberId])
  @@map("claim_invites")
}

model OtpChallenge {
  id          String    @id @db.Uuid
  memberId    String?   @map("member_id") @db.Uuid
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  inviteId    String?   @map("invite_id") @db.Uuid
  invite      ClaimInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  phone       String    @db.VarChar(16)
  purpose     String    @db.VarChar(10)
  codeHash    String    @map("code_hash") @db.Char(64)
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model AuthSession {
  tokenHash   String    @id @map("token_hash") @db.Char(64)
  accountId   String    @map("account_id") @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([accountId])
  @@map("auth_sessions")
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model RegistrationRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ftcId      Int      @map("ftc_id")
  name       String   @db.VarChar(150)
  phone      String   @db.VarChar(16)
  evidence   String   @db.Text
  status     String   @default("pending") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  @@map("registration_requests")
}
